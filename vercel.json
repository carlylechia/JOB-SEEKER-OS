{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/job-discovery",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/queue",
      "schedule": "0 7 * * *"
    }
  ]
}