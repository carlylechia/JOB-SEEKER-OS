generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                       String             @id @default(cuid())
  email                    String             @unique
  passwordHash             String
  name                     String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  emailVerified            DateTime?
  emailVerificationToken   String?            @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?            @unique
  passwordResetExpires     DateTime?
  streakCount              Int                @default(0)
  lastActiveDate           DateTime?
  linkedinId               String?            @unique
  role                     UserRole           @default(USER)
  templates                FollowUpTemplate[]
  jobLeads                 JobLead[]
  createdJobTitles         JobTitle[]         @relation("JobTitleCreator")
  notifications            Notification[]
  profile                  UserProfile?
  careerExperiences        CareerExperience[]
  careerEducation          CareerEducation[]
  careerSkills             CareerSkill[]
  careerProjects           CareerProject[]
  careerCredentials        CareerCredential[]

  subscription              Subscription?
  usageRecords              UsageRecord[]
  upgradeRequests           UpgradeRequest[]
  subscriptionEvents        SubscriptionEvent[]
  actedSubscriptionEvents   SubscriptionEvent[] @relation("SubscriptionEventActor")
  resolvedUpgradeRequests   UpgradeRequest[]    @relation("UpgradeRequestResolver")
  adminUpdatedSubscriptions Subscription[]      @relation("SubscriptionAdminUpdater")
  resumeDocuments           ResumeDocument[]
  resumeExtractions         ResumeExtraction[]  @relation("ExtractionOwner")
  confirmedCareerRecords    CareerRecordSource[]
  jobAnalyses               JobIntelligenceAnalysis[]
  structuredResumes         StructuredResume[]
  resumeOptimizations       ResumeOptimization[]
  prepPacks                 InterviewPrepPack[]
  practiceAttempts          InterviewPracticeAttempt[]
  applicationMaterials      ApplicationMaterial[]
  careerActions             CareerAction[]
  jobDiscoveryRuns          JobDiscoveryRun[]
  dailyJobRecommendations   DailyJobRecommendation[]

  @@index([createdAt])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@index([role])
}

model UserProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  headline               String?
  portfolioUrl           String?
  githubUrl              String?
  linkedinUrl            String?
  resumeUrl              String?
  currentLevel           String    @default("MID")
  targetLevel            String    @default("MID")
  targetRoles            String[]
  preferredRegions       String[]
  preferredTitles        String[]
  preferredStack         String[]
  mustHaveTech           String[]
  workRegions            String[]
  timezoneMatches        String[]
  remoteOnly             Boolean   @default(true)
  salaryMin              Int       @default(0)
  salaryTarget           Int       @default(0)
  timezoneToleranceHours Int       @default(4)
  onboardingCompleted    Boolean   @default(false)
  onboardingCompletedAt  DateTime?
  onboardingSkipped      Boolean   @default(false)
  onboardingStep         Int       @default(1)
  profilePictureUrl      String?
  remotePreference       String?
  location               String?
  profileCompleted       Boolean   @default(false)
  profileCompletedAt     DateTime?
  linkedinPhotoUrl       String?

  // ── Confirmed career profile (Resume Intelligence) ────────────────────────
  // Additive only: every pre-existing column above keeps its meaning and its
  // value. `resumeUrl` remains the "primary resume" pointer used by the
  // existing download, onboarding and profile flows.
  phone                   String?
  summary                 String?
  websiteUrl              String?
  careerProfileConfirmedAt DateTime?
  /// Incremented on every confirmed save. The client echoes the version it
  /// loaded; a mismatch means someone else (or another tab) saved first, and
  /// the write is rejected with 409 rather than silently clobbering it.
  careerProfileVersion    Int       @default(0)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  experiences            CareerExperience[]
  education              CareerEducation[]
  skills                 CareerSkill[]
  projects               CareerProject[]
  credentials            CareerCredential[]

  @@index([careerProfileConfirmedAt])
}

model JobLead {
  id                  String    @id @default(cuid())
  userId              String
  company             String
  title               String
  source              String?
  jobUrl              String?
  location            String?
  remoteType          String?
  timezoneRequirement String?
  eligibilityRegion   String?
  salaryMin           Int?
  salaryMax           Int?
  currency            String?   @default("USD")
  notes               String?
  /// The pasted job description, kept separate from `notes`.
  ///
  /// `notes` is a free-text field the ingestion flow fills with generated clue
  /// strings ("Detected stack: … | Eligibility clues: …") and that users
  /// overwrite freely, so it is not a dependable source of what the employer
  /// actually wrote. Job Intelligence needs a field that means "this is the
  /// posting", which is why this one was added rather than trying to parse
  /// `notes`.
  ///
  /// Nullable and additive: existing rows keep working exactly as before, and
  /// a job with no description still analyses on its metadata alone.
  jobDescription      String?
  status              String    @default("LEAD")
  dateFound           DateTime  @default(now())
  dateApplied         DateTime?
  nextFollowUp        DateTime?
  priorityFlag        String    @default("MONITOR")
  score               Json
  checklist           Json
  contacts            Json
  interviews          Json
  prepPack            Json
  expiresAt           DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses            JobIntelligenceAnalysis[]
  /// Resumes tailored towards this specific role. Deleting the job clears the
  /// association; the resume itself survives, because a resume is not owned by
  /// the job it was written for.
  targetedResumes     StructuredResume[] @relation("StructuredResumeTargetJob")
  /// Structured interview preparation packs for this job.
  prepPacks           InterviewPrepPack[]
  applicationMaterials ApplicationMaterial[]
  careerActions        CareerAction[]

  @@index([userId, status])
  @@index([userId, company])
  @@index([userId, title])
  @@index([userId, priorityFlag])
  @@index([userId, nextFollowUp])
  @@index([userId, updatedAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model FollowUpTemplate {
  id        String   @id @default(cuid())
  userId    String
  type      String
  name      String
  subject   String?
  body      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  /// A generated material always names the template it came from, so a
  /// material can be traced back without the template ever being modified.
  applicationMaterials ApplicationMaterial[]
}

model JobTitle {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("JobTitleCreator", fields: [createdById], references: [id])

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// MONETIZATION FOUNDATION
//
// Plan → Subscription → Entitlements is the single source of truth for access.
// Effective access is always derived from stored timestamps, never trusted
// blindly from a `status` column. See docs/ARCHITECTURE.md.
// ─────────────────────────────────────────────────────────────────────────────

enum PlanCode {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

/// Where the current access record came from. Allows a future payment provider
/// to be introduced without changing the entitlement engine.
enum SubscriptionSource {
  TRIAL
  ADMIN_MANUAL
  FUTURE_BILLING
  SYSTEM
}

enum UpgradeRequestStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ContactMethod {
  EMAIL
  WHATSAPP
}

enum SubscriptionEventType {
  TRIAL_STARTED
  TRIAL_EXTENDED
  TRIAL_EXPIRED
  PLAN_UPGRADED
  PLAN_DOWNGRADED
  PLAN_CHANGED_BY_ADMIN
  PLAN_SUSPENDED
  PLAN_RESTORED
}

model Plan {
  id           String   @id @default(cuid())
  code         PlanCode @unique
  name         String
  slug         String   @unique
  description  String
  /// Monetary values are stored as integer minor units (e.g. cents) to avoid
  /// floating-point arithmetic. NULL means "pricing not yet decided" — the UI
  /// renders "Contact us" rather than inventing a number.
  monthlyPrice Int?
  yearlyPrice  Int?
  currency     String   @default("USD")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]

  @@index([active, sortOrder])
}

/// Singleton record holding the immutable monetization launch configuration.
/// The existing-user trial window is derived from `enabledAt` exactly once and
/// must never be recomputed per-request.
model MonetizationConfig {
  id                         String    @id @default("global")
  enabledAt                  DateTime?
  existingUserTrialStartedAt DateTime?
  existingUserTrialEndsAt    DateTime?
  trialDays                  Int       @default(14)
  trialPlan                  PlanCode  @default(PRO)
  initializedAt              DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

/// Exactly one current access record per user. Enforced by a unique userId so
/// competing subscriptions cannot create ambiguous entitlements.
model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  planId                 String
  status                 SubscriptionStatus
  startsAt               DateTime
  endsAt                 DateTime?
  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  source                 SubscriptionSource @default(SYSTEM)
  /// Provider-neutral fields for a future automated billing integration.
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?
  updatedByAdminId       String?
  adminNote              String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan  @relation(fields: [planId], references: [id])
  updatedByAdmin User? @relation("SubscriptionAdminUpdater", fields: [updatedByAdminId], references: [id])

  @@index([planId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([endsAt])
  @@index([status, trialEndsAt])
}

/// Immutable audit trail of every subscription/access change.
model SubscriptionEvent {
  id                    String                @id @default(cuid())
  userId                String
  actorAdminId          String?
  type                  SubscriptionEventType
  previousPlanCode      PlanCode?
  newPlanCode           PlanCode?
  previousStatus        SubscriptionStatus?
  newStatus             SubscriptionStatus?
  previousStartsAt      DateTime?
  newStartsAt           DateTime?
  previousEndsAt        DateTime?
  newEndsAt             DateTime?
  previousTrialStartsAt DateTime?
  previousTrialEndsAt   DateTime?
  newTrialEndsAt        DateTime?
  reason                String?
  createdAt             DateTime              @default(now())

  actorAdmin User? @relation("SubscriptionEventActor", fields: [actorAdminId], references: [id])
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([actorAdminId, createdAt])
}

model UpgradeRequest {
  id                    String               @id @default(cuid())
  userId                String
  requestedPlan         PlanCode
  /// Snapshots preserve what the user saw at request time, even after the
  /// underlying subscription changes.
  currentPlanSnapshot   PlanCode?
  currentStatusSnapshot SubscriptionStatus?
  contactMethod         ContactMethod
  contactEmail          String?
  whatsappNumber        String?
  message               String
  status                UpgradeRequestStatus @default(PENDING)
  adminNote             String?
  resolvedByAdminId     String?
  resolvedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user            User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedByAdmin User? @relation("UpgradeRequestResolver", fields: [resolvedByAdminId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([requestedPlan])
}

/// Generic usage accounting. One table for all metered features so new AI
/// capabilities never require a new table.
model UsageRecord {
  id             String   @id @default(cuid())
  userId         String
  featureKey     String
  units          Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  idempotencyKey String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey, periodStart, idempotencyKey])
  @@index([userId, featureKey, periodStart])
  @@index([periodStart, periodEnd])
}

/// Durable transactional email queue. A failed provider call must never roll
/// back or fail the business transaction that enqueued the message.
model EmailOutbox {
  id                String            @id @default(cuid())
  type              String
  recipient         String
  payload           Json
  status            EmailOutboxStatus @default(PENDING)
  attempts          Int               @default(0)
  nextAttemptAt     DateTime          @default(now())
  lastError         String?
  providerMessageId String?
  idempotencyKey    String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
  @@index([recipient])
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// RESUME INTELLIGENCE
//
// A stored resume is a durable artefact, an extraction is a run against one
// artefact, and a career profile is what the user chose to keep from it. Keeping
// those three separate is what lets us re-run analysis, audit where a value
// came from, and never overwrite existing profile data without being told to.
//
// `UserProfile.resumeUrl` is intentionally left in place: it is the "primary
// resume" pointer used by the existing download, onboarding and profile flows,
// and this release must not change how those behave.
// ─────────────────────────────────────────────────────────────────────────────

/// One resume the user has stored.
///
/// Previously a resume existed only as a single `UserProfile.resumeUrl` string,
/// which made "which resume was this extracted from?" unanswerable. Rows are
/// backfilled from that column, so every existing upload becomes a real
/// document without the user doing anything.
model ResumeDocument {
  id          String   @id @default(cuid())
  userId      String
  /// Server-derived storage URL. Never a client-supplied filename, never used
  /// as an access-control identifier on its own.
  url         String
  /// Sanitised display name only. Storage names are generated server-side.
  fileName    String
  /// Chosen by sniffing magic bytes on the server, not from the upload name.
  format      String
  sizeBytes   Int
  /// True for the document currently referenced by `UserProfile.resumeUrl`.
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractions ResumeExtraction[]

  @@index([userId, createdAt])
  @@index([userId, isPrimary])
}

/// One analysis run against one version of one document.
///
/// The unique constraint on (resumeId, contentHash, schemaVersion) is doing two
/// jobs: it lets an unchanged document reuse a completed result instead of
/// paying for the same extraction again, and it makes the row itself the lock
/// that stops two identical requests triggering two provider calls.
model ResumeExtraction {
  id            String                  @id @default(cuid())
  resumeId      String
  userId        String
  /// SHA-256 of the normalised text we would send to the provider. Hashing the
  /// text rather than the bytes means a re-exported identical resume reuses the
  /// cached result. Scoped to a user: one user's extraction is never served to
  /// another.
  contentHash   String
  /// Contract version this result conforms to. Bumping it invalidates old rows
  /// instead of silently serving them under a newer contract.
  schemaVersion Int
  status        String                  @default("PROCESSING")
  /// Structured extraction, stored as JSON because it is versioned,
  /// pre-confirmation, variable-shaped data. Confirmed values are promoted into
  /// the relational career tables; this stays as the reviewable draft.
  data          Json?
  /// Only a machine-readable code. The user-facing copy lives in
  /// `EXTRACTION_ERROR_MESSAGES`, never in the database.
  errorCode     String?
  provider      String?
  model         String?
  /// Truncation is recorded so the review UI can say "this resume was longer
  /// than we analysed" instead of implying full coverage.
  wasTruncated  Boolean                 @default(false)
  extractedChars Int?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  completedAt   DateTime?

  resume    ResumeDocument @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user      User           @relation("ExtractionOwner", fields: [userId], references: [id], onDelete: Cascade)
  appliedTo CareerRecordSource[]

  @@unique([resumeId, contentHash, schemaVersion])
  @@index([userId, createdAt])
  @@index([userId, status])
}

/// Provenance for every confirmed career-profile record.
///
/// Kept as its own relation rather than three nullable columns on each table so
/// that "which resume did this come from" stays answerable for every section,
/// and so deleting a resume can find exactly what it produced.
model CareerRecordSource {
  id             String   @id @default(cuid())
  extractionId   String
  userId         String
  /// Logical section this record came from, e.g. 'experience', 'education'.
  section        String
  /// Primary key of the confirmed row within that section.
  recordId       String
  confirmedAt    DateTime @default(now())

  extraction ResumeExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([section, recordId])
  @@index([userId, section])
  @@index([extractionId])
}

/// A confirmed role. Relational because job matching and tailored resume
/// generation both need to query and filter these by company, title and dates.
model CareerExperience {
  id              String    @id @default(cuid())
  profileId       String
  userId          String
  jobTitle        String?
  company         String?
  location        String?
  startDate       String?
  endDate         String?
  isCurrent       Boolean   @default(false)
  responsibilities String[]
  achievements    String[]
  technologies    String[]
  /// Short label for the section of the resume this came from.
  sourceSection   String?
  evidenceSnippet String?
  /// True when the document contradicted itself here and the user has not
  /// resolved it. Kept visible rather than silently dropped.
  hasConflict     Boolean   @default(false)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([profileId, sortOrder])
  @@index([company])
}

model CareerEducation {
  id              String    @id @default(cuid())
  profileId       String
  userId          String
  institution     String?
  qualification   String?
  fieldOfStudy    String?
  startDate       String?
  endDate         String?
  details         String?
  sourceSection   String?
  evidenceSnippet String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endDate])
  @@index([profileId, sortOrder])
}

/// A skill the user has confirmed. `origin` is carried through from extraction
/// so an inferred skill can never be presented as a verified one.
model CareerSkill {
  id              String    @id @default(cuid())
  profileId       String
  userId          String
  name            String
  /// STATED | SUPPORTED | INFERRED, from the extraction contract.
  origin          String    @default("INFERRED")
  evidenceSnippet String?
  confirmed       Boolean   @default(false)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([userId, confirmed])
}

model CareerProject {
  id              String    @id @default(cuid())
  profileId       String
  userId          String
  name            String?
  description     String?
  role            String?
  technologies    String[]
  startDate       String?
  endDate         String?
  projectUrl      String?
  results         String[]
  sourceSection   String?
  evidenceSnippet String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@index([profileId, sortOrder])
}

/// Certifications, licences, languages, awards, publications and volunteer work.
/// One table with a `kind` discriminator: they share a shape, they are queried
/// together for tailored resumes, and splitting them would add structure
/// without adding meaning.
model CareerCredential {
  id              String    @id @default(cuid())
  profileId       String
  userId          String
  kind            String
  name            String
  issuer          String?
  issuedDate      String?
  expiresDate     String?
  proficiency     String?
  details         String?
  sourceSection   String?
  evidenceSnippet String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([profileId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI JOB INTELLIGENCE
//
// One analysis is one user's reading of one job, at one point in time, from
// one set of inputs. It is never shared and never written onto a shared job
// record: a personalised verdict about someone's career, stored anywhere other
// than their own rows, is a privacy problem even when the job itself is public.
//
// The unique index on (userId, jobId, inputFingerprint, schemaVersion) does two
// jobs at once, the same way `ResumeExtraction` does: it is the cache key that
// stops a user paying twice for the same answer, and it is the lock that stops
// two identical requests triggering two provider calls.
// ─────────────────────────────────────────────────────────────────────────────

model JobIntelligenceAnalysis {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  /// Contract version this result conforms to. Bumping it invalidates old rows
  /// instead of silently serving them under a newer contract.
  schemaVersion   Int
  /// SHA-256 over the normalised job, profile, preference and scoring inputs.
  /// A completed result is reusable only while this still matches.
  inputFingerprint String
  status          String   @default("PROCESSING")
  /// The verified structured analysis. Stored as JSON because it is versioned
  /// and variable-shaped data, and because the model's contribution and the
  /// application's own deterministic facts live side by side in it.
  data            Json?
  /// Only a machine-readable code. The user-facing copy lives in
  /// `ANALYSIS_ERROR_MESSAGES`, never in the database.
  errorCode       String?
  provider        String?
  model           String?
  /// True when the posting text was cut before analysis. Lets the UI say "this
  /// analysis ran on a shortened posting" rather than implying full coverage.
  jobTextTruncated Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  job  JobLead @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, inputFingerprint, schemaVersion])
  @@index([userId, jobId, createdAt])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// RESUME BUILDER
//
// `ResumeDocument` above is an UPLOADED FILE: a pointer to a stored PDF/DOCX
// plus its size and sniffed format. It is what the parse pipeline, the
// onboarding step and the profile download all read, and this release does not
// change any of that.
//
// `StructuredResume` is a different thing: a document the user BUILDS. It is
// editable, template-driven, exportable to PDF, and independently owned by the
// user. Keeping the two apart is deliberate. Folding editable content into
// `ResumeDocument` would make "which file did this extraction come from?"
// unanswerable and would break every existing upload flow.
//
// VERSIONING IS BY INDEPENDENT DOCUMENT, NOT BY SNAPSHOT ROW. A tailored
// variant is its own row that deep-copies the source content at the moment it
// is created and then diverges. There is no shared mutable state, so editing a
// variant can never touch the master, deleting a variant can never touch the
// master, and there is nothing to reconstruct.
//
// `content` is JSON, and that is the right shape here rather than a set of
// child tables: the document is edited, validated, versioned and rendered as
// ONE unit, never queried by an inner field. Everything that genuinely needs a
// relational query — who owns it, which job it targets, which resume it came
// from — is a real column and a real index.
// ─────────────────────────────────────────────────────────────────────────────

model StructuredResume {
  id     String @id @default(cuid())
  userId String
  /// User-editable display name, e.g. "Frontend Engineer — Acme".
  name   String

  /// The validated structured document (see `src/lib/resume-builder/schema.ts`).
  /// Written only by the server after Zod validation; a client cannot store an
  /// arbitrary shape here.
  content Json

  /// Presentation only. Templates never change what the content means.
  templateKey String @default("classic-ats")
  /// Physical page dimensions selected by the user; A4 remains the default.
  pageSize String @default("A4")
  /// Key from the approved accent palette in `templates.ts`. Not a raw colour.
  accentKey   String @default("gold")
  /// 0 = compact, 1 = comfortable, 2 = relaxed. Bounded server-side.
  density     Int    @default(1)

  /// Section keys the user has chosen to hide, e.g. ['certifications'].
  /// Presentation only — the content is still stored and still exportable.
  hiddenSections String[]

  /// Preferred presentation order, shared by the editor, PDF and DOCX.
  sectionOrder String[] @default(["summary", "experience", "skills", "education", "projects", "credentials"])

  /// Optimistic-concurrency counter. A save carries the revision it was built
  /// from; a mismatch is rejected with 409 rather than silently clobbering a
  /// newer edit. Same mechanism, and the same intent, as
  /// `UserProfile.careerProfileVersion`.
  revision Int @default(1)

  /// The job this resume is tailored to. `SetNull` so deleting a job keeps the
  /// user's written work.
  targetJobId String?

  /// The resume this one was duplicated or tailored from. Self-relation so a
  /// variant can always name its own origin. `SetNull` for the same reason.
  sourceResumeId String?

  /// How this document came into existence, for provenance:
  /// PROFILE | BLANK | DUPLICATE | OPTIMIZATION.
  origin String @default("BLANK")

  /// `UserProfile.careerProfileVersion` at the moment this resume was populated
  /// from the profile. Recorded so the UI can tell the user their profile has
  /// moved on since this resume was created — it is never used to write back.
  sourceProfileVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJob     JobLead?      @relation("StructuredResumeTargetJob", fields: [targetJobId], references: [id], onDelete: SetNull)
  sourceResume  StructuredResume?  @relation("StructuredResumeVariants", fields: [sourceResumeId], references: [id], onDelete: SetNull)
  variants      StructuredResume[] @relation("StructuredResumeVariants")
  optimizations ResumeOptimization[]
  applicationMaterials ApplicationMaterial[]
  careerActions        CareerAction[]

  @@index([userId, updatedAt])
  @@index([userId, targetJobId])
  @@index([sourceResumeId])
}

/// One AI run that proposed changes to one resume for one job.
///
/// Same shape and the same two jobs as `JobIntelligenceAnalysis`:
/// the unique index on (userId, resumeId, jobId, inputFingerprint,
/// schemaVersion) is BOTH the cache key that stops a user paying twice for the
/// same proposal AND the lock that stops two identical requests triggering two
/// provider calls.
///
/// `baseRevision` is the `StructuredResume.revision` the model actually saw. A
/// proposal whose resume has since been edited is detected as stale at read and
/// at apply time, so suggestions can never be written onto a different document
/// from the one they were generated against.
model ResumeOptimization {
  id       String @id @default(cuid())
  userId   String
  resumeId String
  jobId    String
  /// Contract version this result conforms to. Bumping it invalidates old rows.
  schemaVersion Int
  /// Bumped when the PROMPT changes but the output shape does not.
  promptVersion Int  @default(1)
  /// SHA-256 over the normalised resume content, target job and career profile.
  inputFingerprint String
  /// `StructuredResume.revision` the model was given.
  baseRevision Int
  status String @default("PROCESSING")
  /// The verified, bounded proposal. Stored as JSON because it is versioned,
  /// variable-shaped data and every operation in it has been re-checked against
  /// the real resume before being written.
  data Json?
  /// Only a machine-readable code. User-facing copy lives in
  /// OPTIMIZATION_ERROR_MESSAGES, never in the database.
  errorCode String?
  provider  String?
  model     String?
  creditsConsumed Int @default(0)
  /// True when the job description or the career profile was too thin to
  /// analyse properly, so the review UI can say so rather than implying the
  /// proposal saw everything.
  thinInputs Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  completedAt DateTime?

  resume StructuredResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resumeId, jobId, inputFingerprint, schemaVersion])
  @@index([userId, resumeId, createdAt])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTERVIEW INTELLIGENCE & PREPARATION PACKS (Pro Release 6)
//
// A preparation pack belongs to one user and targets one of their jobs.
// Questions are relational records so each one can be edited, reordered,
// versioned and practiced individually. Practice attempts are relational so
// history survives question refreshes and a user can reopen a pack and see
// their previous work.
//
// The existing `JobLead.prepPack` JSON column (free-form talking points) is
// left untouched: this is the structured, AI-powered counterpart, and the two
// surfaces link through the job record rather than duplicating one another.
// ─────────────────────────────────────────────────────────────────────────────

/// The interview contexts a pack can prepare for. Stored as a string so the
/// set can grow without a schema change; the application validates the value.
model InterviewPrepPack {
  id                 String   @id @default(cuid())
  userId             String
  jobId              String
  /// User-visible title, e.g. "Northwind — Backend Engineer (recruiter screen)".
  title              String
  /// Selected preparation context. BALANCED means no specific stage was known.
  context            String
  status             String   @default("ACTIVE") // ACTIVE | ARCHIVED
  /// Contract version this pack's question set conforms to.
  schemaVersion      Int      @default(1)
  /// Prompt version used to generate the current question set.
  promptVersion      Int      @default(1)
  /// SHA-256 over the normalised inputs (job, profile, resume, context).
  /// Changed inputs produce a new fingerprint and mark the pack stale.
  inputFingerprint   String
  /// Short generation guidance and honest limitations, stored so a reopened
  /// pack still shows them without regenerating.
  preparationGuidance String?
  limitations         String[]
  /// Cached progress snapshot, kept in sync on write and recomputed on read.
  questionCount      Int      @default(0)
  practicedCount     Int      @default(0)
  feedbackCount      Int      @default(0)
  lastPracticedAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     JobLead                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]   @relation("PackQuestions")
  attempts InterviewPracticeAttempt[] @relation("PackAttempts")
  careerActions CareerAction[]

  @@index([userId, jobId])
  @@index([userId, status, updatedAt])
  @@index([jobId, updatedAt])
  /// One pack per user, job and input fingerprint: the unique index doubles
  /// as the lock that stops two identical generation requests from running
  /// (and being charged) at once.
  @@unique([userId, jobId, inputFingerprint])
}

/// One question inside a pack. Versioned rows let a refresh retire the old
/// set without detaching the practice attempts that used it.
model InterviewQuestion {
  id              String   @id @default(cuid())
  packId          String
  /// Version within this pack. 1 for the first generated set; incremented on
  /// every refresh so attempts stay attached to the version they used.
  version         Int      @default(1)
  ordinal         Int      @default(0)
  category        String   // TECHNICAL_FUNDAMENTALS | BEHAVIORAL | ... (see schema.ts)
  difficulty      String   // FOUNDATION | APPLIED | ADVANCED
  competency      String   // e.g. "React component lifecycle", "Conflict resolution"
  question        String
  whyMatters      String?
  relatedRequirement String?
  /// Grounded suggestion from the user's own profile, or null when none exists.
  relevantExperience String?
  prepNotes       String?
  /// STAR | TECHNICAL | ARCHITECTURE | null (no framework forced).
  answerStructure String?
  /// IDs of follow-up questions generated from this one, bounded in quantity.
  followUpQuestionIds String[]
  sourceType      String   // GENERATED | MANUAL | EDITED
  /// Reference to the job requirement or profile field that justifies this question.
  sourceEvidence  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  pack InterviewPrepPack @relation("PackQuestions", fields: [packId], references: [id], onDelete: Cascade)
  attempts InterviewPracticeAttempt[] @relation("QuestionAttempts")

  @@index([packId, ordinal])
  @@index([packId, isActive])
  @@index([packId, version])
}

/// One saved attempt at answering one question version.
model InterviewPracticeAttempt {
  id               String   @id @default(cuid())
  userId           String
  packId           String
  questionId       String
  /// The InterviewQuestion.version this attempt was made against.
  questionVersion  Int
  answer           String
  /// Structured feedback produced by the evaluation step (rubric, notes, etc.).
  feedback         Json?
  rubricKey        String?
  attemptNumber    Int      @default(1)
  createdAt        DateTime @default(now())

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack     InterviewPrepPack       @relation("PackAttempts", fields: [packId], references: [id], onDelete: Cascade)
  question InterviewQuestion     @relation("QuestionAttempts", fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, packId])
  @@index([packId, questionId])
  @@index([userId, createdAt])
}

enum ApplicationMaterialType {
  COVER_LETTER
  RECRUITER_OUTREACH
  LINKEDIN_CONNECTION
  APPLICATION_FOLLOW_UP
  APPLICATION_STATUS_CHECK
  INTERVIEW_THANK_YOU
}

enum ApplicationMaterialStatus {
  DRAFT
  READY
  ARCHIVED
}

enum ApplicationMaterialOrigin {
  AI_GENERATED
  AI_REVISED
  TEMPLATE_DERIVED
  MANUAL
}

model ApplicationMaterial {
  id     String @id @default(cuid())
  userId String

  type   ApplicationMaterialType
  status ApplicationMaterialStatus @default(DRAFT)
  origin ApplicationMaterialOrigin @default(AI_GENERATED)

  /// Generated on save from the material type, job company/title and createdAt.
  title String

  /// The letter or message itself. What the user edits, copies and exports.
  /// Preserves line breaks; bounded server-side on every write.
  content String @db.Text

  /// Optional subject line. Null for materials that have no subject, such as a
  /// LinkedIn connection note.
  subject String?

  // ── Provenance ────────────────────────────────────────────────────────────
  // Nullable throughout: a recruiter message legitimately has no job, and
  // forcing a job association would be inventing a relationship that does not
  // exist. What IS stored is always resolved against rows this user owns.

  /// The saved job this material is for. `SetNull`: deleting a job must not
  /// destroy the user's written work.
  jobId String?

  /// The tailored resume used as context, when one was selected.
  resumeId String?

  /// The stored template this was generated from, so a material can always
  /// name its origin without the template itself ever being modified.
  templateId String?

  /// This material's own revision number within its chain. Starts at 1.
  revision Int @default(1)

  /// The revision this one replaced. Null on a first draft.
  /// `SetNull`: deleting an old revision leaves its successors intact.
  supersedesId String?

  /// Real application facts at generation time (stage, applied date, next
  /// follow-up). Snapshotted so a later status change does not rewrite history
  /// about what the letter could honestly say when it was written.
  jobStage       String?
  appliedAt      DateTime?
  nextFollowUpAt DateTime?

  // ── Generation record ─────────────────────────────────────────────────────

  /// Contract version this result conforms to. Bumping it invalidates reuse.
  schemaVersion Int @default(1)

  /// Bumped when the PROMPT changes but the output shape does not.
  promptVersion Int @default(1)

  /// SHA-256 over the normalised inputs that produced this row. A completed
  /// row is reusable only while this still matches.
  inputFingerprint String

  /// Server run state. Distinct from `status`: a failed generation leaves a row
  /// the user can delete, and says nothing about their draft's lifecycle.
  generationStatus String @default("PROCESSING")

  /// Verified claims, evidence, review notes and warnings. JSON because it is
  /// versioned and variable-shaped, and because the model contributed to it
  /// only after re-checking against the real sources.
  generationMeta Json?

  /// Only a machine-readable code; user-facing copy lives in
  /// MATERIAL_ERROR_MESSAGES and never in the database.
  errorCode String?

  provider String?
  model    String?

  creditsConsumed Int @default(0)

  /// True when job text or profile context was cut before generation, so the
  /// review UI can say so rather than implying full coverage.
  thinInputs Boolean @default(false)

  /// Incremented on every manual save. The client echoes the value it loaded;
  /// a mismatch means the draft changed underneath them and the write is
  /// rejected with 409 rather than silently clobbering it.
  editVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        JobLead?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resume     StructuredResume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  template   FollowUpTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  supersedes ApplicationMaterial?  @relation("ApplicationMaterialRevisions", fields: [supersedesId], references: [id], onDelete: SetNull)
  revisions  ApplicationMaterial[] @relation("ApplicationMaterialRevisions")

  @@index([userId, updatedAt])
  @@index([userId, type, updatedAt])
  @@index([userId, status])
  @@index([jobId])
  @@index([supersedesId])
  @@unique([userId, type, inputFingerprint, schemaVersion])
}

model CareerAction {
  id               String    @id @default(cuid())
  userId           String
  actionType       String
  title            String
  description      String?
  status           String    @default("PENDING")
  priority         Int       @default(0)
  dueDate          DateTime?
  estimatedMinutes Int?
  sourceType       String
  sourceId         String?
  relatedJobId     String?
  relatedResumeId  String?
  relatedPrepPackId String?
  origin           String    @default("SYSTEM")
  snoozedUntil     DateTime?
  completedAt      DateTime?
  dismissedAt      DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedJob    JobLead?         @relation(fields: [relatedJobId], references: [id], onDelete: SetNull)
  relatedResume StructuredResume? @relation(fields: [relatedResumeId], references: [id], onDelete: SetNull)
  relatedPrepPack InterviewPrepPack? @relation(fields: [relatedPrepPackId], references: [id], onDelete: SetNull)

  @@unique([userId, actionType, sourceId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
  @@index([relatedJobId])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTELLIGENT DAILY JOB DISCOVERY
// ─────────────────────────────────────────────────────────────────────────────

model ExternalJob {
  id                  String    @id @default(cuid())
  source              String
  sourceJobId         String
  canonicalUrl        String?
  applicationUrl      String?
  employerUrl         String?
  title               String
  company             String
  location            String?
  remoteType          String?
  workArrangement     String?
  employmentType      String?
  description         String?
  salaryMin           Int?
  salaryMax           Int?
  currency            String?   @default("USD")
  publishedAt         DateTime?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  lastVerifiedAt      DateTime?
  status              String    @default("OPEN")
  contentFingerprint  String?
  attribution         String?
  normalizedSkills    Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  recommendations     DailyJobRecommendation[]

  @@unique([source, sourceJobId])
  @@index([company, title])
  @@index([status])
  @@index([lastVerifiedAt])
  @@index([canonicalUrl])
}

model JobDiscoveryRun {
  id                    String    @id @default(cuid())
  userId                String
  localDate             String
  timezone              String
  status                String    @default("PENDING")
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  candidateCount        Int       @default(0)
  eligibleCount         Int       @default(0)
  recommendationCount   Int       @default(0)
  sourcesAttempted      Int       @default(0)
  sourcesSucceeded      Int       @default(0)
  inputFingerprint      String?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations       DailyJobRecommendation[]

  @@unique([userId, localDate])
  @@index([status])
  @@index([userId, localDate])
}

model DailyJobRecommendation {
  id                String    @id @default(cuid())
  runId             String
  userId            String
  externalJobId     String
  rank              Int
  fitScore          Float
  confidence        Float?
  scoreBreakdown    Json
  explanation       Json?
  status            String    @default("RECOMMENDED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  run               JobDiscoveryRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalJob       ExternalJob      @relation(fields: [externalJobId], references: [id], onDelete: Cascade)

  @@unique([runId, externalJobId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([runId, rank])
}

model JobSourceHealth {
  id                  String    @id @default(cuid())
  sourceId            String    @unique
  displayName         String
  connectorType       String
  enabled             Boolean   @default(false)
  configured          Boolean   @default(false)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  failureCategory     String?
  lastError           String?
  jobsRetrieved       Int       @default(0)
  jobsAccepted        Int       @default(0)
  duplicatesDiscarded Int       @default(0)
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())
}
