generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String             @id @default(cuid())
  email                    String             @unique
  passwordHash             String
  name                     String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  emailVerified            DateTime?
  emailVerificationToken   String?            @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?            @unique
  passwordResetExpires     DateTime?
  streakCount              Int                @default(0)
  lastActiveDate           DateTime?
  linkedinId               String?            @unique
  templates                FollowUpTemplate[]
  jobLeads                 JobLead[]
  createdJobTitles         JobTitle[]         @relation("JobTitleCreator")
  notifications            Notification[]
  profile                  UserProfile?

  @@index([createdAt])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
}

model UserProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  headline               String?
  portfolioUrl           String?
  githubUrl              String?
  linkedinUrl            String?
  resumeUrl              String?
  currentLevel           String    @default("MID")
  targetLevel            String    @default("MID")
  targetRoles            String[]
  preferredRegions       String[]
  preferredTitles        String[]
  preferredStack         String[]
  mustHaveTech           String[]
  workRegions            String[]
  timezoneMatches        String[]
  remoteOnly             Boolean   @default(true)
  salaryMin              Int       @default(0)
  salaryTarget           Int       @default(0)
  timezoneToleranceHours Int       @default(4)
  onboardingCompleted    Boolean   @default(false)
  onboardingCompletedAt  DateTime?
  onboardingSkipped      Boolean   @default(false)
  onboardingStep         Int       @default(1)
  profilePictureUrl      String?
  remotePreference       String?
  location               String?
  profileCompleted       Boolean   @default(false)
  profileCompletedAt     DateTime?
  linkedinPhotoUrl       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobLead {
  id                  String    @id @default(cuid())
  userId              String
  company             String
  title               String
  source              String?
  jobUrl              String?
  location            String?
  remoteType          String?
  timezoneRequirement String?
  eligibilityRegion   String?
  salaryMin           Int?
  salaryMax           Int?
  currency            String?   @default("USD")
  notes               String?
  status              String    @default("LEAD")
  dateFound           DateTime  @default(now())
  dateApplied         DateTime?
  nextFollowUp        DateTime?
  priorityFlag        String    @default("MONITOR")
  score               Json
  checklist           Json
  contacts            Json
  interviews          Json
  prepPack            Json
  expiresAt           DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, company])
  @@index([userId, title])
  @@index([userId, priorityFlag])
  @@index([userId, nextFollowUp])
  @@index([userId, updatedAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model FollowUpTemplate {
  id        String   @id @default(cuid())
  userId    String
  type      String
  name      String
  subject   String?
  body      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model JobTitle {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("JobTitleCreator", fields: [createdById], references: [id])

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
