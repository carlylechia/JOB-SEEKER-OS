{
  "name": "job-seeker-os",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "monetization:initialize": "tsx scripts/monetization-initialize.ts",
    "monetization:status": "tsx scripts/monetization-status.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "admin:revoke": "tsx scripts/revoke-admin.ts",
    "maintenance:run": "tsx scripts/run-maintenance.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.16.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.2",
    "cli": "^1.0.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "0.511.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.1",
    "resend": "^6.10.0",
    "swr": "^2.4.1",
    "vercel": "^50.38.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.13.9",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.3",
    "prisma": "^6.16.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.3",
    "typescript": "5.8.2"
  }
}
