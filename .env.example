# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/job_seeker_os?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="teChia Jobs <noreply@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"

# ── Monetization ────────────────────────────────────────────────────────────
# Where new upgrade requests are notified. Server-side only.
ADMIN_NOTIFICATION_EMAIL="admin@yourdomain.com"

# Bearer token for /api/cron/*. Must be at least 16 characters.
# Cron endpoints FAIL CLOSED without this — they are unreachable, not public.
CRON_SECRET="replace-with-a-long-random-secret-at-least-16-chars"

# Emergency kill switch: set to "false" to stop new trials starting.
MONETIZATION_ENABLED="true"

# Development only: shorten trials locally. Ignored in production.
# DEV_TRIAL_DAYS="1"

# ── Storage (Vercel Blob) ───────────────────────────────────────────────────
# Resumes are stored as PRIVATE blobs and served through an authenticated route.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxx"

# ── AI (Resume Intelligence + Job Intelligence) ────────────────────────────
# Server-side only. Never expose as NEXT_PUBLIC_* — anything public ships to
# the browser. Without this key, analysis endpoints return a clear
# configuration error and never simulate a successful result.
#
# One key, two features. Both draw on the same PLAN_LIMITS.aiCredits budget,
# so a customer has a single AI allowance rather than several competing ones.
OPENAI_API_KEY="sk-xxxxxxxxx"

# Optional. Model used for resume extraction. Must support Structured Outputs.
# Defaults to gpt-4o-mini — chosen by benchmarking extraction accuracy against a
# resume with a known ground truth, where it matched the more expensive models
# exactly while costing 5.8x less per analysis.
# Read in exactly one place, so changing model never means hunting the codebase.
# RESUME_INTELLIGENCE_MODEL="gpt-4o-mini"

# Optional. Model used for job-fit analysis. Must support Structured Outputs.
# Defaults to gpt-4.1-mini — chosen for being the best balance between price and
# caution on an output that drives a real career decision. Still 3.4x cheaper
# than the previous default.
# Read in exactly one place, and independent of the resume model so the two
# features can be tuned separately without a code change.
# JOB_INTELLIGENCE_MODEL="gpt-4.1-mini"

# Optional. Model used for job-specific resume optimisation. Must support
# Structured Outputs. Defaults to gpt-4.1-mini — the same model as job
# intelligence, chosen for the same reason: the output is read by a person
# deciding what to send to an employer, so its willingness to say "I would need
# the measured result to make this stronger" is worth more than a fraction of a
# cent. Independent of the other two, so all three can be tuned separately
# without a code change.
# RESUME_OPTIMIZATION_MODEL="gpt-4.1-mini"

# Optional. Model used to generate interview preparation packs and answer
# feedback. Must support Structured Outputs. Defaults to gpt-4.1-mini; read in
# exactly one place and independent of the resume, job and optimisation models.
# INTERVIEW_PREP_MODEL="gpt-4.1-mini"

# ── PDF export ───────────────────────────────────────────────────────────────
# No configuration required. Fonts ship with the application
# (@expo-google-fonts/inter, SIL Open Font License 1.1) and are embedded
# server-side at export time. Nothing is stored: a PDF is generated per request
# from the authorised document and streamed back through
# /api/resumes/[id]/export.pdf.

# ── Daily Job Discovery & Multi-Source Catalog ──────────────────────────────
# Primary ATS and public feeds (Ashby, Greenhouse, Lever, Remote OK, Himalayas,
# Arbeitnow, 4dayweek) require no API keys and are enabled by default.
# Individual sources can be toggled using these variables:
# ASHBY_ENABLED="true"
# GREENHOUSE_ENABLED="true"
# LEVER_ENABLED="true"
# REMOTEOK_ENABLED="true"
# HIMALAYAS_ENABLED="true"
# ARBEITNOW_ENABLED="true"
# FOURDAYWEEK_ENABLED="true"

# 4dayweek free feed configuration: page offset where public unlocked listings start
# FOURDAYWEEK_START_PAGE="24"

# Optional Himalayas free API key for increased rate limits (60 req/min, 10k/day)
# HIMALAYAS_API_KEY="your-himalayas-api-key"

# USAJOBS Integration (Official US Federal Government Jobs API)
# Requires an API key from https://developer.usajobs.gov/ and a contact email User-Agent
# USAJOBS_ENABLED="true"
# USAJOBS_API_KEY="your-usajobs-api-key"
# USAJOBS_USER_AGENT="your-email@yourdomain.com"

# Headcount Labs Integration (Developer Job Postings API)
# Requires subscription key from Headcount Labs and license acknowledgment
# HEADCOUNTLABS_ENABLED="false"
# HEADCOUNTLABS_API_KEY="your-headcountlabs-api-key"
# HEADCOUNTLABS_LICENSE_ACK="true"

# Serverless catalog sync execution budget in milliseconds (default: 50000)
# CATALOG_SYNC_MAX_DURATION_MS="50000"

# ── Optional ────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
CORS_ORIGIN=""
ALERT_WEBHOOK_URL=""